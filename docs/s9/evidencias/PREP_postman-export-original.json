      "name": "01 - Preparación y consultas (solo lectura)",
      "item": [
        {
          "name": "01 - Clientes: resolver IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const clientes = pm.response.json().contenido;",
                  "const activo = clientes.find(c => c.estado);",
                  "const inactivo = clientes.find(c => !c.estado);",
                  "pm.test(\"Cliente activo e inactivo disponibles\", () => { pm.expect(activo).to.exist; pm.expect(inactivo).to.exist; });",
                  "for (const [key, cliente] of [[\"clienteId\", activo], [\"clienteInactivoId\", inactivo]]) {",
                  "  if (cliente) pm.collectionVariables.set(key, String(cliente.id));",
                  "  else pm.collectionVariables.unset(key);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clientes?pagina=0&tamanio=100&ordenarPor=id&direccion=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "0"
                },
                {
                  "key": "tamanio",
                  "value": "100"
                },
                {
                  "key": "ordenarPor",
                  "value": "id"
                },
                {
                  "key": "direccion",
                  "value": "asc"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - Productos: resolver IDs y precondiciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const productos = pm.response.json().contenido;",
                  "const disponibles = productos.filter(p => p.estado && p.stock > 0);",
                  "pm.test(\"Al menos 8 productos activos con stock\", () => pm.expect(disponibles.length).to.be.at.least(8));",
                  "for (const [key, producto] of [",
                  "  [\"producto1250Id\", disponibles.find(p => p.precio === 12.5)],",
                  "  [\"producto1890Id\", disponibles.find(p => p.precio === 18.9)],",
                  "  [\"productoIntermedioId\", disponibles.find(p => p.precio === 1.2)],",
                  "  [\"productoStock2Id\", disponibles.find(p => p.stock === 2)]",
                  "]) {",
                  "  pm.test(key + \" disponible\", () => pm.expect(producto).to.exist);",
                  "  if (producto) pm.collectionVariables.set(key, String(producto.id));",
                  "  else pm.collectionVariables.unset(key);",
                  "}",
                  "// M-01 y V-03 necesitan stock exactamente 2 antes de su ejecución."
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos?pagina=0&tamanio=100&ordenarPor=id&direccion=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "0"
                },
                {
                  "key": "tamanio",
                  "value": "100"
                },
                {
                  "key": "ordenarPor",
                  "value": "id"
                },
                {
                  "key": "direccion",
                  "value": "asc"
                }
              ]
            }
          },
          "response": []
        },
