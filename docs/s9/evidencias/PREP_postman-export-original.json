              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const venta = pm.response.json();",
                  "pm.collectionVariables.set(\"ventaId\", String(venta.id));",
                  "pm.test(\"Total 75.30 = 12.50 x3 + 18.90 x2\", () => pm.expect(venta.total).to.eql(75.3));",
                  "pm.test(\"Dos líneas y cinco unidades\", () => { pm.expect(venta.detalles.length).to.eql(2); pm.expect(venta.detalles.reduce((n,d) => n+d.cantidad,0)).to.eql(5); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
