              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"detalles\": [\n    { \"productoId\": {{producto1250Id}}, \"cantidad\": 3 },\n    { \"productoId\": {{producto1890Id}}, \"cantidad\": 2 }\n  ]\n}",
